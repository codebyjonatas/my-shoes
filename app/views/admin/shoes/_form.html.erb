<%= form_with model: shoe, url: (shoe.persisted? ? admin_shoe_path(shoe) : admin_shoes_path), class: "space-y-6" do |f| %>
  <% if shoe.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="text-sm font-medium text-red-800">Corrija os erros abaixo:</div>
      <ul class="mt-2 list-disc pl-5 text-sm text-red-700">
        <% shoe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4">
    <div>
      <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :description, "Descrição", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <%= f.label :gender, "Gênero", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :gender, options_for_select([["Masculino", "male"], ["Feminino", "female"], ["Unissex", "unisex"]], shoe.gender), { include_blank: "Selecione" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :brand_id, "Marca", class: "block text-sm font-medium text-gray-700" %>
        <%= f.collection_select :brand_id, Brand.order(:name), :id, :name, { prompt: "Selecione" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>
      <div>
        <%= f.label :category_id, "Categoria", class: "block text-sm font-medium text-gray-700" %>
        <%= f.collection_select :category_id, Category.order(:position), :id, :name, { prompt: "Selecione" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>
    </div>
  </div>

  <fieldset>
    <legend class="text-sm font-medium text-gray-700">Variantes (tamanho, preço e estoque)</legend>
    <div data-controller="variants">
      <div id="variants" class="mt-3 space-y-3">
        <%= f.fields_for :shoe_variants, shoe.shoe_variants.to_a do |vf| %>
          <div class="variant-row grid grid-cols-3 gap-3">
            <div>
              <%= vf.label :size_id, "Tamanho", class: "block text-xs font-medium text-gray-500" %>
              <%= vf.collection_select :size_id, Size.order(:value_cm), :id, :label, { prompt: "Selecione" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
            </div>
            <div>
              <%= vf.label :price, "Preço", class: "block text-xs font-medium text-gray-500" %>
              <%= vf.number_field :price, step: "0.01", min: "0.01", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
            </div>
            <div>
              <%= vf.label :stock_quantity, "Estoque", class: "block text-xs font-medium text-gray-500" %>
              <%= vf.number_field :stock_quantity, min: "0", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
            </div>
          </div>
        <% end %>
      </div>
      <button type="button" data-action="variants#addRow" class="mt-3 rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50">
        + Adicionar variante
      </button>
    </div>

    <template id="variant-template">
      <div class="variant-row grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-medium text-gray-500">Tamanho</label>
          <select name="shoe[shoe_variants_attributes][__index__][size_id]" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
            <option value="">Selecione</option>
            <% Size.order(:value_cm).each do |size| %>
              <option value="<%= size.id %>"><%= size.label %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500">Preço</label>
          <input type="number" step="0.01" min="0.01" name="shoe[shoe_variants_attributes][__index__][price]" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500">Estoque</label>
          <input type="number" min="0" name="shoe[shoe_variants_attributes][__index__][stock_quantity]" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
        </div>
      </div>
    </template>
  </fieldset>

  <div class="flex gap-3">
    <%= f.submit "Salvar", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <%= link_to "Voltar", admin_shoes_path, class: "rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>