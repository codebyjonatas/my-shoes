<% content_for :title, "My Shoes" %>

<div class="w-full">
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Catálogo de Calçados</h1>
    <p class="mt-2 text-gray-600">Encontre o par perfeito para você.</p>
  </header>

  <%= form_with url: root_path, method: :get, class: "mb-8 space-y-4", data: { turbo_frame: "catalog" } do |f| %>
    <div class="flex flex-wrap gap-4 items-end">
      <div>
        <%= f.label :search, "Buscar", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :search, value: params[:search], placeholder: "Nome ou descrição...", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= f.label :gender, "Gênero", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :gender, options_for_select([["Masculino", "male"], ["Feminino", "female"], ["Unissex", "unisex"]], params[:gender]), { include_blank: "Todos" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>
      <label class="inline-flex items-center">
        <%= f.check_box :in_stock, { checked: params[:in_stock] == "1" }, "1", nil %>
        <span class="ml-2 text-sm text-gray-700">Somente em estoque</span>
      </label>
      <div>
        <%= f.submit "Filtrar", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      </div>
    </div>
  <% end %>

  <div id="catalog" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @shoes.each do |shoe| %>
      <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-900"><%= shoe.name %></h2>
        <p class="mt-1 text-sm text-gray-500"><%= shoe.brand.name %> · <%= shoe.category.name %></p>
        <p class="mt-2 text-sm text-gray-700 line-clamp-2"><%= shoe.description %></p>
        <div class="mt-3 flex items-center justify-between">
          <span class="text-sm font-medium text-gray-600"><%= shoe.gender %></span>
          <span class="text-lg font-bold text-indigo-600">
            <%= number_to_currency(shoe.shoe_variants.minimum(:price)) %>
          </span>
        </div>
        <p class="mt-1 text-xs text-gray-400">
          <%= shoe.shoe_variants.sum(:stock_quantity) %> unidades em estoque
        </p>
      </article>
    <% end %>
  </div>

  <% if @shoes.empty? %>
    <p class="mt-8 text-center text-gray-500">Nenhum calçado encontrado com esses filtros.</p>
  <% end %>
</div>