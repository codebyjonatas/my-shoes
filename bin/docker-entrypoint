#!/bin/bash -e

# When booting a web server (rails server or puma), prepare the database
# (create + migrate) and optionally seed idempotent data. This covers both
# the default Dockerfile CMD and platform-provided start commands.
case "${*}" in
  *"rails server"*|*"puma"*)
    ./bin/rails db:prepare

    if [ "$SEED_ON_BOOT" == "true" ]; then
      ./bin/rails db:seed
    fi
    ;;
esac

exec "${@}"
